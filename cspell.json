{
    "version": "0.2",
    "import": [
        "https://cdn.jsdelivr.net/npm/@cspell/dict-it-it@3/cspell-ext.json"
    ],
    "language": "it, it-IT, en-GB, en-US",
    "dictionaries": [
        "italian",
        "en-gb",
        "en-us"
    ],
    "ignorePaths": [
        ".git",
        "**/template_*.typ",
        "cspell.json"
    ],
    "ignoreRegExpList": [
        "#[a-zA-Z0-9_]+"
    ],
    "words": [
        "Biba",
        "changelog",
        "doctitle",
        "Gyulai",
        "Lucchi",
        "meetingplace",
        "meetingtime",
        "Moro",
        "pagebreak",
        "Sironi",
        "Tuoni",
        "typst",
        "Vardanega",
        "versionamento"
    ]
}